# Copy to /home/pi/.config/rfstag/local.env to override /etc/rfstag/base.env.
# Normally written by Ansible.

# Brigade name; defaults to the hostname.
#KIOSK_BRIGADE=mybrigade

# Default is 'station'. Several kiosks at one brigade need different names.
#KIOSK_LOCATION=station

# Production is rfstag.com; anything else is for testing.
#BUSHFIRE_SERVER=rfstag.org

# On-screen keyboard launched with the kiosk (install separately).
#SCREEN_KEYBOARD=/usr/bin/onboard
