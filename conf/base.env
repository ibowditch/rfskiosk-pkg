# RFStag kiosk defaults, read by every kiosk service and script.
# Don't edit this file on a kiosk: put overrides in /home/pi/.config/rfstag/local.env
# (Ansible writes that one), e.g. KIOSK_LOCATION, KIOSK_BRIGADE, BUSHFIRE_SERVER.

NFC_INI_FILE=/etc/rfstag/nfcreader.ini
BUSHFIRE_SERVER=rfstag.com
KIOSK_LOCATION=station
# KIOSK_BRIGADE defaults to the hostname.

# Position of a second HDMI screen, if present.
HDMI2_X_OFFSET=1920
